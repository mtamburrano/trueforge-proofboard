# This file contains selectors plus the server-only key used by the direct
# deterministic proof adapter. TrueForge still stores model and MCP credentials
# in its local server configuration; do not put those credentials here.
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_MODEL=alibaba/qwen3-8-max
TRUEFORGE_GITHUB_SERVER=github
TRUEFORGE_GITHUB_OWNER=mtamburrano
TRUEFORGE_GITHUB_REPO=trueforge-proofboard
TRUEFORGE_GITHUB_REF=main
TRUEFORGE_GITHUB_PATH=package.json
TRUEFORGE_UI_HOST=127.0.0.1
TRUEFORGE_UI_PORT=8787
TRUEFORGE_MISSION_STATE=.trueforge/mission-state.json

# Set this only for a TrueForge server with OIDC login enabled.
# TRUEFORGE_TOKEN=

# Required for direct implementation proof against the persisted Daytona sandbox.
# DAYTONA_API_KEY=
# Optional when using a non-default Daytona API deployment.
# DAYTONA_API_URL=https://app.daytona.io/api
