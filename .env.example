# This file contains selectors only. TrueForge stores provider, MCP, and Daytona
# credentials in its local server configuration; do not put credentials here.
TRUEFORGE_BASE_URL=http://localhost:8790
TRUEFORGE_MODEL=alibaba/qwen3-8-max
TRUEFORGE_GITHUB_SERVER=github
TRUEFORGE_GITHUB_OWNER=mtamburrano
TRUEFORGE_GITHUB_REPO=trueforge-proofboard
TRUEFORGE_GITHUB_REF=main
TRUEFORGE_GITHUB_PATH=package.json
TRUEFORGE_UI_HOST=127.0.0.1
TRUEFORGE_UI_PORT=8787
TRUEFORGE_MISSION_STATE=.trueforge/mission-state.json

