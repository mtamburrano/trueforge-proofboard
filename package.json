{
  "name": "trueforge-proofboard",
  "version": "0.1.0",
  "description": "TrueForge Agent Harness Hackathon submission for verified autonomous software delivery.",
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-http-assets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test",
    "check": "npm run typecheck && npm test",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env dist/http/start.js",
    "smoke:trueforge": "node --env-file-if-exists=.env scripts/trueforge-smoke.mjs",
    "test:m2": "npm run build && node scripts/m2-integration.mjs"
  },
  "devDependencies": {
    "@truefoundry/trueforge-sdk": "0.1.3",
    "typescript": "^5.9.2"
  }
}
